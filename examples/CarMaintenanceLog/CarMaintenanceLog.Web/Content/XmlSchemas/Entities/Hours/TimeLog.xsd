<?xml version="1.0" encoding="utf-8"?>
<xs:schema id="TimeLog"
    targetNamespace="oobdev://Schemas/Entities/Hours/TimeLog"
    elementFormDefault="qualified"
    xmlns="oobdev://Schemas/Entities/Hours/TimeLog"
    xmlns:mstns="oobdev://Schemas/Entities/Hours/TimeLog"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
>

  <xs:complexType name="timelogType">
    <xs:attribute name="id" type="xs:int" use="required" />
    <xs:attribute name="date" type="xs:date" use="required" />

    <xs:attribute name="start" type="xs:time" use="required" />
    <xs:attribute name="break.start" type="xs:time" use="optional" />
    <xs:attribute name="break.end" type="xs:time" use="optional" />
    <xs:attribute name="end" type="xs:time" use="required" />

    <xs:attribute name="note" type="xs:string" use="required" />


    <xs:attribute name="invoice.id" type="xs:int" use="optional" />
    <xs:attribute name="project.id" type="xs:int" use="optional" />
    <xs:attribute name="car.id" type="xs:int" use="optional" />

    <xs:attribute name="miles" type="xs:float" use="optional" />
    
  </xs:complexType>

  <xs:element name="timelog" type="timelogType" />
  
</xs:schema>