<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mobile.ViewModels.Entry"
             x:Class="Mobile.Views.Entry.EntryPage">
    <ContentPage.BindingContext>
        <vm:EntryPageViewModel />
    </ContentPage.BindingContext>
    
    <Frame WidthRequest="200" HeightRequest="200" HorizontalOptions="Center" VerticalOptions="Center" HasShadow="True" BackgroundColor="Black" >
        <StackLayout VerticalOptions="Center" HorizontalOptions="FillAndExpand">
            <Button Command="{Binding EnterAppCommand}" Text="Root Page" HeightRequest="40" WidthRequest="150" BackgroundColor="Gray"/>
            <Button Command="{Binding EnterTabsCommand}" Text="Tabbed Root Page" HeightRequest="40" WidthRequest="150" BackgroundColor="Gray"/>
            <Button Command="{Binding EnterCarouselCommand}" Text="Carousel Root Page" HeightRequest="40" WidthRequest="150" BackgroundColor="Gray" />
        </StackLayout>
    </Frame>

</ContentPage>