      <Column Name="Make" Type="System.String" DbType="NVarChar(100) NOT NULL" CanBeNull="false" />
      <Column Name="Model" Type="System.String" DbType="NVarChar(100) NOT NULL" CanBeNull="false" />
      <Column Name="Year" Type="System.Int32" DbType="Int NOT NULL" CanBeNull="false" />
      <Column Name="OwnerID" Type="System.Int32" DbType="Int NOT NULL" CanBeNull="false" />
      <Association Name="Car_InsurancePoliciesForCar" Member="InsurancePoliciesForCars" ThisKey="CarID" OtherKey="CarID" Type="InsurancePoliciesForCar" />
      <Association Name="Car_PaymentsCar" Member="PaymentsCars" ThisKey="CarID" OtherKey="CarID" Type="PaymentsCar" />
      <Association Name="Car_PaymentsCarsFuel" Member="PaymentsCarsFuels" ThisKey="CarID" OtherKey="CarID" Type="PaymentsCarsFuel" />
      <Association Name="Car_PaymentsCarsMaintenance" Member="PaymentsCarsMaintenances" ThisKey="CarID" OtherKey="CarID" Type="PaymentsCarsMaintenance" />
      <Association Name="User_Car" Member="User" ThisKey="OwnerID" OtherKey="PersonID" Type="User" IsForeignKey="true" />
    </Type>
  </Table>
  <Table Name="dbo.[User]" Member="Users">
    <Type Name="User">
      <Column Name="PersonID" Type="System.Int32" DbType="Int NOT NULL IDENTITY" IsPrimaryKey="true" IsDbGenerated="true" CanBeNull="false" />
      <Column Name="Username" Type="System.String" DbType="VarChar(100) NOT NULL" CanBeNull="false" />
      <Column Name="Email" Type="System.String" DbType="VarChar(255) NOT NULL" CanBeNull="false" />
      <Association Name="User_Car" Member="Cars" ThisKey="PersonID" OtherKey="OwnerID" Type="Car" />
      <Association Name="User_InsurancePolicy" Member="InsurancePolicies" ThisKey="PersonID" OtherKey="HolderID" Type="InsurancePolicy" />
    </Type>
  </Table>
  <Table Name="dbo.InsurancePolicies" Member="InsurancePolicies">
