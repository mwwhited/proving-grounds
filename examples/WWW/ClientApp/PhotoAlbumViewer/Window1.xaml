<Window x:Class="PhotoAlbumViewer.Window1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:photo="clr-namespace:PhotoAlbumViewer"
    Title="Window1" Height="300" Width="300">

    <Window.Resources>
        <photo:BinaryImageConverter x:Key="imgConverter" />
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <TreeView   
            Grid.Row="0" Grid.Column="0" Background="LightBlue"
            
            Name="treeview1"
            ItemsSource="{x:Static photo:DirectoryNode.Root}"
            >
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Path=Children}">
                    <TextBlock FontWeight="Bold" Text="{Binding Path=CurrentPath}" />
                    <HierarchicalDataTemplate.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Path=Name}"/>
                        </DataTemplate>
                    </HierarchicalDataTemplate.ItemTemplate>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
        
        <ListBox
            Grid.Row="0" Grid.Column="1" Background="LightGreen"
            
            Name="listbox1"
            ItemsSource="{Binding SelectedItem.Photos, ElementName=treeview1}"
            >
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Image Source="{Binding Path=ImageData, Converter={StaticResource imgConverter}}" />
                    <!--<Label Content="{Binding Path=Name}" />-->
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>


</Window>
