<?xml version="1.0" encoding="utf-8"?>
<Database Name="MyAuthentication" Class="DataMyAuthenticationDataContext" xmlns="http://schemas.microsoft.com/linqtosql/dbml/2007">
  <Connection Mode="AppSettings" ConnectionString="Data Source=TROJAN\SQLEXPRESS;Initial Catalog=MyAuthentication;Integrated Security=True" SettingsObjectName="WhitedUS.Security.Properties.Settings" SettingsPropertyName="MyAuthenticationConnectionString" Provider="System.Data.SqlClient" />
  <Table Name="dbo.MySession" Member="MySessions">
