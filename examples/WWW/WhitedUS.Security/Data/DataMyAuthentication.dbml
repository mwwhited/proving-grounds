      <Column Name="PasswordHash" Type="System.String" DbType="VarChar(50) NOT NULL" CanBeNull="false" />
      <Column Name="DateCreated" Type="System.DateTime" DbType="DateTime NOT NULL" CanBeNull="false" />
      <Column Name="DateLastLogin" Type="System.DateTime" DbType="DateTime" CanBeNull="true" />
      <Column Name="DateLastActivity" Type="System.DateTime" DbType="DateTime" CanBeNull="true" />
      <Column Name="DateLastPasswordChange" Type="System.DateTime" DbType="DateTime" CanBeNull="true" />
