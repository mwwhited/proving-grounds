      <Column Name="Locked" Type="System.Boolean" DbType="Bit NOT NULL" CanBeNull="false" />
      <Column Name="SessionItems" Type="System.String" DbType="NVarChar(MAX)" CanBeNull="true" />
      <Column Name="Flags" Type="System.Int32" DbType="Int NOT NULL" CanBeNull="false" />
      <Column Name="UserID" Type="System.Guid" DbType="UniqueIdentifier NOT NULL" CanBeNull="false" />
      <Association Name="MyUser_MySession" Member="MyUser" ThisKey="UserID" Type="MyUser" IsForeignKey="true" />
      <Association Name="MyApplication_MySession" Member="MyApplication" ThisKey="ApplicationID" Type="MyApplication" IsForeignKey="true" />
    </Type>
  </Table>
  <Table Name="dbo.MyUser" Member="MyUsers">
