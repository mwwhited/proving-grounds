@model WhitedUS.MediaLibrary.Models.MediaModel

@{
    ViewBag.Title = "Details";
}

<h2>Details</h2>

<fieldset>
    <legend>MediaModel</legend>

    <div class="display-label">LocalID</div>
    <div class="display-field">
        @Html.DisplayFor(model => model.LocalID)
    </div>

    <div class="display-label">Title</div>
    <div class="display-field">
        @Html.DisplayFor(model => model.Title)
    </div>

    <div class="display-label">BoxTitle</div>
    <div class="display-field">
        @Html.DisplayFor(model => model.BoxTitle)
    </div>

    <div class="display-label">Code</div>
    <div class="display-field">
        <a href='@string.Format("{0}{1}", this.Model.CodeType.Url, this.Model.Code)' target='_top'>@this.Model.Code</a>
    </div>

    <div class="display-label">DiskNumber</div>
    <div class="display-field">
        @Html.DisplayFor(model => model.DiskNumber)
    </div>

    <div class="display-label">Format</div>
    <div class="display-field">
        @Html.DisplayFor(model => model.Format)
    </div>

    <div class="display-label">Have</div>
    <div class="display-field">
        @Html.DisplayFor(model => model.Have)
    </div>

    <div class="display-label">Length</div>
    <div class="display-field">
        @Html.DisplayFor(model => model.Length)
    </div>

    <div class="display-label">Notes</div>
    <div class="display-field">
        @Html.DisplayFor(model => model.Notes)
    </div>

    <div class="display-label">Rating</div>
    <div class="display-field">
        @Html.DisplayFor(model => model.Rating)
    </div>

    <div class="display-label">Year</div>
    <div class="display-field">
        @Html.DisplayFor(model => model.Year)
    </div>

    <div class="display-label">Media Type</div>
    <div class="display-field">
        @Html.DisplayFor(model => model.MediaType)
    </div>
</fieldset>
<p>

    @if (this.Request.IsAuthenticated) {
        <span>
            @Html.ActionLink("Edit", "Edit", new { id=Model.LocalID,}) 
        |</span>
    }
    @Html.ActionLink("Back to List", "Index")
</p>
