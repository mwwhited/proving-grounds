@model WhitedUS.MediaLibrary.Models.MediaTypeModel
@{
    ViewBag.Title = "Create";

    var codeTypes = new[] {new SelectListItem {
             Value = "",
             Text="(Select Code Type)",
        }}.Concat(
            from mediaType in this.Model.CodeTypes.AsEnumerable()
            orderby mediaType.Name 
            select new SelectListItem
            {
                Value = mediaType.LocalID.ToString(),
                Text = mediaType.Name,
                Selected = mediaType.LocalID == this.Model.CodeTypeID,
            }
        );
}
<h2>
    Create</h2>
<script src="@Url.Content("~/Scripts/jquery.validate.min.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")" type="text/javascript"></script>
@using (Html.BeginForm())
{
    @Html.ValidationSummary(true)
    <fieldset>
        <legend>Media Type</legend>

        <div class="editor-label">
            @Html.LabelFor(model => model.Name)
        </div>
        <div class="editor-field">
            @Html.EditorFor(model => model.Name)
            @Html.ValidationMessageFor(model => model.Name)
        </div>
        
        <div class="editor-label">
            @Html.LabelFor(model => model.CodeTypeID)
        </div>
        <div class="editor-field">
            @Html.DropDownListFor(model => model.CodeTypeID, codeTypes)
            @Html.ValidationMessageFor(model => model.CodeTypeID)
        </div>

        <p>
            <input type="submit" value="Create" />
        </p>
    </fieldset>
}
<div>
    @Html.ActionLink("Back to List", "Index")
</div>
