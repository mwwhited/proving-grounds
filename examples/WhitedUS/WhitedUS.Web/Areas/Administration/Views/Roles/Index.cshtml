@{
    ViewBag.Title = "Index";
}

@section Header{
    <script src="@Url.Content("~/Areas/Administration/Scripts/RoleModel.js")" type="text/javascript"></script>  
}

<h2>Roles</h2>

<table>
    <thread>
        <tr>
            <th>Role Name</th>
            <th>Commands</th>
        </tr>
    </thread>
    <tbody data-bind="foreach: roles">
        <tr>
            <td data-bind="text: RoleName"></td>
            <td>
                <a data-bind="click: $parent.deleteRole">Delete</a>
            </td>
        </tr>
    </tbody>
</table>

<form data-bind="submit: addRole">
    <input type="text" data-bind="value: RoleName" />
    <button type="submit">Add</button>
</form>