    <TornPageDetection>False</TornPageDetection>
    <Trustworthy>False</Trustworthy>
    <UpdateOptions>READ_WRITE</UpdateOptions>
    <VardecimalStorageFormatOn>True</VardecimalStorageFormatOn>
