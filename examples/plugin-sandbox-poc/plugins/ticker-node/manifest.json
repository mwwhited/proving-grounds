{
  "id": "ticker-node",
  "version": "0.1.0",
  "protocol": "2.1",
  "entry": { "dev": ["node", "plugin.js"] },
  "platforms": ["win-x64", "linux-x64", "osx-universal"],
  "lifetime": "Bound",
  "capabilities": { "data": "none", "publish": ["demo.tick"], "subscribe": [], "sendTo": [] },
  "limits": { "msgPerSec": 200, "maxFrameBytes": 1048576 },
  "heartbeatTimeout": "5s"
}
