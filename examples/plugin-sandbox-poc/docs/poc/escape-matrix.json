{
  "_comment": "Each row is one capability a sandboxed plugin must not have. 'deny' tests must pass for it to count as held; 'control' tests prove the same plugin can do the thing when allowed, so a denial is not just a broken plugin. A row with no 'deny' tests is reported as unverified.",
  "os": {
    "windows": { "title": "Windows (AppContainer + job object)" },
    "linux": { "title": "Linux (bubblewrap + seccomp + prlimit)" }
  },
  "rows": [
    { "id": "net-loopback", "what": "Connect to a service on the host machine",
      "windows": { "deny": ["Loopback_services_on_the_host_machine_cannot_be_reached"], "control": ["Control_loopback_is_reachable_without_the_sandbox"] },
      "linux": { "deny": ["Loopback_services_on_the_host_machine_cannot_be_reached"], "control": ["Control_loopback_is_reachable_without_the_sandbox"] } },
    { "id": "net-internet", "what": "Connect to the internet",
      "windows": { "deny": ["The_internet_cannot_be_reached"], "control": ["Control_loopback_is_reachable_without_the_sandbox"] },
      "linux": { "deny": ["The_internet_cannot_be_reached"], "control": ["Control_loopback_is_reachable_without_the_sandbox"] } },
    { "id": "net-dns", "what": "Resolve a name",
      "windows": { "deny": ["Names_cannot_be_resolved"], "control": ["Control_names_resolve_without_the_sandbox"] },
      "linux": { "deny": ["Names_cannot_be_resolved"], "control": ["Control_names_resolve_without_the_sandbox"] } },
    { "id": "spawn", "what": "Start a child process",
      "windows": { "deny": ["A_plugin_cannot_start_a_child_process", "A_plugin_cannot_start_children_in_a_loop"], "control": ["Control_without_the_sandbox_a_plugin_can_start_many_children"] },
      "linux": { "deny": ["By_default_a_plugin_cannot_start_a_child_process", "By_default_a_plugin_cannot_fork"], "control": ["Control_a_plugin_that_is_allowed_children_can_start_one", "Control_threads_still_work_under_the_filter"] } },
    { "id": "fork-bomb", "what": "Fork without limit",
      "windows": { "deny": ["A_plugin_cannot_start_children_in_a_loop"], "control": ["Control_without_the_sandbox_a_plugin_can_start_many_children"] },
      "linux": { "deny": ["A_task_limit_contains_a_fork_bomb_when_children_are_allowed", "A_task_limit_of_one_stops_a_plugin_starting_a_child_process"], "control": ["Control_a_plugin_that_is_allowed_children_can_start_one"] } },
    { "id": "read-outside", "what": "Read files or list folders outside its grants",
      "windows": { "deny": ["A_file_outside_every_grant_cannot_be_read", "A_folder_outside_every_grant_cannot_be_listed", "The_users_own_files_cannot_be_read"], "control": ["Control_a_granted_folder_can_be_read_listed_and_written"] },
      "linux": { "deny": ["A_file_outside_every_grant_cannot_be_read", "A_folder_outside_every_grant_cannot_be_listed", "The_users_own_files_cannot_be_read", "Etc_passwd_and_shadow_are_not_visible"], "control": ["Control_a_granted_folder_can_be_read_listed_and_written"] } },
    { "id": "write-outside", "what": "Write to a read-only grant or to its own folder",
      "windows": { "deny": ["A_read_only_grant_cannot_be_written", "The_plugins_own_folder_cannot_be_modified"], "control": ["Control_a_granted_folder_can_be_read_listed_and_written"] },
      "linux": { "deny": ["A_read_only_grant_cannot_be_written", "The_plugins_own_folder_cannot_be_modified"], "control": ["Control_a_granted_folder_can_be_read_listed_and_written"] } },
    { "id": "host-process", "what": "Open or see the host process",
      "windows": { "deny": ["The_host_process_cannot_be_opened"], "control": ["Control_the_plugin_runs_in_an_appcontainer"] },
